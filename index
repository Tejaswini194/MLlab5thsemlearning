from sklearn.metrics import r2_score, mean_absolute_error
import matplotlib.pyplot as plt

np.random.seed(31)
n = 400
age      = np.random.randint(1, 15, n)
model_yr = 2025 - age                                  # duplicates age exactly
mileage  = (age * 12000 + np.random.normal(0, 15000, n)).clip(500).round(0)
engine   = np.random.choice([1.0, 1.2, 1.5, 2.0, 2.5], n)

price = (900000 - age*45000 - mileage*1.8 + engine*180000
         + np.random.normal(0, 60000, n)).clip(50000).round(0)

df = pd.DataFrame({"age_years":age, "mileage_km":mileage,
                   "engine_litres":engine, "model_year":model_yr, "price":price})
print(df.head(), "\\n")

# --- 1. Does each extra feature help? ---
print("=== BUILDING UP THE FEATURE SET ===")
sets = [["age_years"],
        ["age_years","mileage_km"],
        ["age_years","mileage_km","engine_litres"]]
for cols in sets:
    X_tr, X_te, y_tr, y_te = train_test_split(
        df[cols], df["price"], test_size=0.2, random_state=3)
    m = LinearRegression().fit(X_tr, y_tr)
    r2 = r2_score(y_te, m.predict(X_te))
    k, rows = len(cols), len(X_te)
    adj = 1 - (1-r2)*(rows-1)/(rows-k-1)
    print(f"{len(cols)} feature(s): R2 = {r2:.4f}  adjusted R2 = {adj:.4f}")

# --- 2. The full model ---
features = ["age_years", "mileage_km", "engine_litres"]
X_tr, X_te, y_tr, y_te = train_test_split(
    df[features], df["price"], test_size=0.2, random_state=3)
model = LinearRegression().fit(X_tr, y_tr)
pred = model.predict(X_te)

print("\\n=== RAW COEFFICIENTS ===")
for f, c in zip(features, model.coef_):
    print(f"  {f:<16} {c:>12,.2f} per unit")
print(f"  {'intercept':<16} {model.intercept_:>12,.2f}")
print("\\nThese CANNOT be ranked - the features are on different scales.")

# --- 3. Standardise, then compare importance fairly ---
sc = StandardScaler()
m_std = LinearRegression().fit(sc.fit_transform(X_tr), y_tr)
print("\\n=== STANDARDISED COEFFICIENTS (comparable) ===")
ranked = sorted(zip(features, m_std.coef_), key=lambda t: -abs(t[1]))
for f, c in ranked:
    print(f"  {f:<16} {c:>12,.2f}")
print(f"\\nStrongest driver of price: {ranked[0][0]}")

print(f"\\n=== PERFORMANCE ===")
