function rotateOptions(list, salt){
  list.forEach((p, pi) => {
    p.mcq.forEach((q, qi) => {
      if (q._rot) return;
      const n = q.o.length;
      const shift = (pi * 7 + qi * 5 + salt) % n;
      const moved = [];
      for (let i = 0; i < n; i++) moved.push(q.o[(i + shift) % n]);
      q.a = (q.a - shift + n) % n;
      q.o = moved;
      q._rot = true;
    });
  });
}
