    print(f"  {str(arch):<14} train={tr:.4f}  test={te:.4f}  gap={tr-te:+.4f}")
print("Bigger is not automatically better - the gap widens as it memorises.")

model = MLPClassifier(hidden_layer_sizes=(16,8), activation="relu",
                      max_iter=1500, random_state=0).fit(X_tr_s, y_tr)
pred  = model.predict(X_te_s)
proba = model.predict_proba(X_te_s)[:, 1]

print(f"\\n=== FINAL NETWORK ===")
print(f"Layers: {model.hidden_layer_sizes},  iterations run: {model.n_iter_}")
print(f"Test accuracy: {accuracy_score(y_te, pred):.4f}")
print("\\nConfusion matrix:")
print(pd.DataFrame(confusion_matrix(y_te, pred),
