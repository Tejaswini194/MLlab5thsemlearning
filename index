# TELECOM CHURN EARLY-WARNING - extract to a weekly call list
# ============================================================
import pandas as pd, numpy as np
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.tree import DecisionTreeClassifier
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier
from sklearn.cluster import KMeans
from sklearn.metrics import (accuracy_score, precision_score, recall_score,
                             f1_score, roc_auc_score, confusion_matrix,
                             classification_report)
import matplotlib.pyplot as plt
np.random.seed(2024)

# --- 1. EXTRACT ---------------------------------------------
n = 2000
tenure   = np.random.randint(0, 72, n)
contract = np.random.choice(["Monthly","One year","Two year"], n, p=[.55,.28,.17])
charge   = np.random.normal(880, 260, n).clip(200).round(0)
calls    = np.random.poisson(1.5, n)
data_gb  = np.random.gamma(3, 4.5, n).round(1)
payment  = np.random.choice(["Auto-debit","Card","Cash"], n, p=[.45,.35,.20])
risk = (-tenure*0.022 + charge/430 + calls*0.36 + (contract=="Monthly")*1.25
        + (payment=="Cash")*0.55 + np.random.normal(0, 0.85, n))
df = pd.DataFrame({"tenure_months":tenure, "contract":contract,
                   "monthly_charge":charge, "support_calls":calls,
                   "data_gb":data_gb, "payment":payment,
                   "churned":(risk > 3.825).astype(int)})
df.loc[df["tenure_months"]==0, "monthly_charge"] = np.nan
df.loc[df.sample(70, random_state=1).index, "data_gb"] = np.nan
df = pd.concat([df, df.sample(90, random_state=2)], ignore_index=True)
print(f"Raw rows {len(df)}, duplicates {df.duplicated().sum()}, "
      f"churn {df['churned'].mean()*100:.1f}%\\n")

# --- 2. CLEAN -----------------------------------------------
df = df.drop_duplicates()
df["is_new"] = df["monthly_charge"].isnull().astype(int)
df["monthly_charge"] = df["monthly_charge"].fillna(0)
df["data_gb"] = df["data_gb"].fillna(df["data_gb"].median())

# --- 3. ENGINEER --------------------------------------------
df["calls_per_month"] = (df["support_calls"]/df["tenure_months"].clip(lower=1)).round(3)
X = pd.get_dummies(df[["tenure_months","monthly_charge","support_calls","data_gb",
                       "contract","payment","is_new","calls_per_month"]],
                   columns=["contract","payment"], drop_first=True)
y = df["churned"]

X_tr, X_te, y_tr, y_te = train_test_split(X, y, test_size=0.25,
                                          random_state=5, stratify=y)
sc = StandardScaler(); X_tr_s, X_te_s = sc.fit_transform(X_tr), sc.transform(X_te)

# --- 4. MODEL -----------------------------------------------
models = {
 "Logistic regression": (LogisticRegression(max_iter=1000, class_weight="balanced"), True),
 "Decision tree (d=5)": (DecisionTreeClassifier(max_depth=5, class_weight="balanced",
                                                random_state=0), False),
 "Random forest":       (RandomForestClassifier(n_estimators=300, class_weight="balanced",
                                                random_state=0, n_jobs=-1), False),
 "Gradient boosting":   (GradientBoostingClassifier(n_estimators=200, random_state=0), False),
}
print("=== MODEL COMPARISON ===")
print(f"{'model':<22} {'acc':>7} {'prec':>7} {'recall':>7} {'f1':>7} {'AUC':>7}")
print("-"*62)
fitted = {}
for name,(m,scale) in models.items():
    a,b = (X_tr_s,X_te_s) if scale else (X_tr,X_te)
    m.fit(a,y_tr); p,pr = m.predict(b), m.predict_proba(b)[:,1]
    fitted[name]=(m,scale,pr)
    print(f"{name:<22} {accuracy_score(y_te,p):>7.4f} "
          f"{precision_score(y_te,p,zero_division=0):>7.4f} "
          f"{recall_score(y_te,p,zero_division=0):>7.4f} "
          f"{f1_score(y_te,p,zero_division=0):>7.4f} {roc_auc_score(y_te,pr):>7.4f}")

best_name = max(fitted, key=lambda k: roc_auc_score(y_te, fitted[k][2]))
model, scaled, proba = fitted[best_name]
print(f"\\nBest by AUC: {best_name}")
pred = model.predict(X_te_s if scaled else X_te)
print("\\n", classification_report(y_te, pred,
      target_names=["stayed","churned"], zero_division=0))

# --- 5. RANK ------------------------------------------------
ranked = pd.DataFrame({"risk":proba.round(4), "actual_churn":y_te.values,
                       "contract":df.loc[y_te.index,"contract"].values,
                       "tenure":df.loc[y_te.index,"tenure_months"].values,
                       "charge":df.loc[y_te.index,"monthly_charge"].values,
                       "calls":df.loc[y_te.index,"support_calls"].values
                      }).sort_values("risk", ascending=False)

# --- 6. LIFT OVER CURRENT PRACTICE --------------------------
CAP = 200
top = ranked.head(CAP)
caught, total = int(top["actual_churn"].sum()), int(ranked["actual_churn"].sum())
current = int(ranked[ranked["contract"]=="Monthly"].head(CAP)["actual_churn"].sum())
np.random.seed(0)
rand = np.mean([ranked.sample(CAP)["actual_churn"].sum() for _ in range(300)])
print(f"\\n=== THE CALL LIST ({CAP} customers) ===")
print(f"Churners in cohort   : {total}")
print(f"Model top {CAP}        : {caught} ({caught/total*100:.1f}%)")
print(f"Current practice     : {current} ({current/total*100:.1f}%)")
print(f"Random               : {rand:.1f}")
print(f"Lift over practice   : {caught/max(current,1):.2f}x")

# --- 7. WHAT TO OFFER THEM ----------------------------------
seg_feats = ["tenure","charge","calls"]
segs = KMeans(n_clusters=3, random_state=0, n_init=10).fit_predict(
       StandardScaler().fit_transform(top[seg_feats]))
top = top.assign(segment=segs)
print("\\n=== SEGMENTS INSIDE THE CALL LIST ===")
print(top.groupby("segment")[seg_feats + ["risk"]].mean().round(2))
print("\\nEach segment needs a different offer - one script for all 200 wastes the list.")

# --- 8. VISUALISE -------------------------------------------
fig, ax = plt.subplots(1,2, figsize=(14,5))
sizes = range(20, len(ranked)+1, 20)
ax[0].plot(sizes, [ranked.head(s)["actual_churn"].sum()/total*100 for s in sizes],
           marker="o", color="teal", linewidth=2, label="Model ranking")
ax[0].plot(sizes, [s/len(ranked)*100 for s in sizes], "--", color="grey",
           label="Random list")
ax[0].axvline(CAP, color="darkorange", linestyle=":", label=f"Capacity = {CAP}")
ax[0].set_xlabel("Customers called"); ax[0].set_ylabel("% of churners reached")
ax[0].set_title("Targeted List vs Current Practice"); ax[0].legend(); ax[0].grid(alpha=.3)
names = [n for n in fitted]; aucs = [roc_auc_score(y_te, fitted[n][2]) for n in names]
ax[1].barh(names, aucs, color="teal", edgecolor="black")
ax[1].set_xlim(0.5, 1.0); ax[1].set_xlabel("AUC"); ax[1].set_title("Model Comparison")
plt.tight_layout(); plt.show()`,
  decision:{
    head:"Replace the contract-expiry list with a ranked risk list \u2014 same 200 calls, substantially more churners reached.",
    body:"<p>The headline is not the AUC. It is how many actual leavers those same 200 calls reach. Ranking by predicted risk finds meaningfully more of them than the contract-expiry list the team uses today, at zero extra cost. That comparison \u2014 against current practice, not against a perfect model \u2014 is what makes this worth deploying.</p><p>Three decisions did the work. <strong>Class weighting</strong> stopped the model quietly ignoring churners, since at a 20% churn rate 'nobody leaves' is right four times out of five. <strong>Ranking by probability</strong> instead of accepting a hard label turned a yes/no classifier into something that fits a real constraint. And <strong>segmenting inside the call list</strong> is what turns a prediction into an intervention: high-charge short-tenure customers need a pricing conversation, while high-support-call customers need a service fix, and the same script for all 200 wastes most of them.</p><p>On model choice \u2014 if the interpretable models land close to the boosted ensemble, take the interpretable one. A retention team that can see why a customer was flagged makes a better call than one reading a number off a screen, and it is far easier to get signed off.</p>",
    caveats:"<p><strong>The intervention loop breaks your own evaluation.</strong> Once you start calling high-risk customers and the offers work, those customers stay \u2014 and the model that flagged them now looks wrong. That is the intervention succeeding, not the model failing. Plan for it: retrain on a schedule, and hold back a small untreated control group so you can still measure whether the calls are doing anything.</p><p><strong>Everything here is correlational.</strong> The model learned that monthly contracts and frequent support calls precede churn. It cannot tell you that offering a discount will prevent it \u2014 that requires an experiment where some flagged customers get an offer and some do not.</p><p><strong>Check fairness before deployment.</strong> Run recall separately across tenure bands and payment methods. If the model systematically misses one group, those customers silently get worse retention treatment and aggregate recall will never show it.</p><p>Finally, the offer economics belong to finance, not to this analysis. The model ranks risk; whether a discount is worth extending depends on remaining lifetime value versus the cost of the offer, and that number has to come from the business.</p>"
