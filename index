    }).join("");
    return `<div class="q"><h5><b>Q${qi+1}</b>${q.q}</h5>
      <div class="opts">${opts}</div>
      ${st.checked ? `<div class="why"><b>${st.picks[qi]===q.a?"Correct.":"Not quite."}</b> ${q.w}</div>` : ""}
    </div>`;
  }).join("");

  let foot;
  if (st.checked){
    const pct = Math.round(score/total*100);
    const cls = pct >= 80 ? "pass" : pct >= 50 ? "mid" : "low";
    const msg = pct >= 80 ? "Solid \u2014 you have got this one."
              : pct >= 50 ? "Halfway there. Re-read the Concept tab and try again."
              : "Worth going back to the Concept and Explain code tabs before moving on.";
    foot = `<div class="quiz-foot">
      <span class="result ${cls}">You scored ${score} out of ${total} (${pct}%). ${msg}</span>
      <button class="btn btn-ghost" id="retry" style="margin-left:auto">Try again</button></div>`;
  } else {
    foot = `<div class="quiz-foot">
      <button class="btn btn-primary" id="check" ${answered<total?"disabled":""}>Check answers</button>
      <span class="result" style="color:var(--grey-600);font-weight:500">
        ${answered}/${total} answered${answered<total?" \u2014 answer all five to check":""}</span></div>`;
  }
  return `<div class="quiz-head">
    <div><h3>Exercise \u2014 check your understanding</h3>
    <p>Five questions on this practical. Pick an answer for each, then check.</p></div>
    ${st.checked ? `<span class="score">${score}/${total}</span>` : ""}
    </div>${qs}${foot}`;
}

/* ---------- scenario panels ---------- */
function scenPanel(it){
  switch(tab){
    case 0: return `
      <div class="scen"><h4>The situation</h4><p>${it.scenario}</p></div>
      <div class="duo">
        <div class="box"><h4>Inputs or features</h4><p>${it.inputs}</p></div>
        <div class="box"><h4>Target or label</h4><p>${it.target}</p></div>
      </div>
      <div class="mini"><h4>Business question</h4><p>${it.question}</p></div>`;
    case 1: return `
      <p class="prose" style="margin-bottom:22px">Before writing any code, this is the reasoning that decides what the code should do.</p>
      <div class="think-list">${it.thinking.map(([h,p],i) =>
        `<div class="think"><b>${i+1}</b><div><h5>${esc(h)}</h5><p>${p}</p></div></div>`).join("")}</div>`;
    case 2: return `
      <p class="prose" style="margin-bottom:22px">The full path from raw data to a decision someone can act on.</p>
      <div class="flowline">${it.flow.map(([h,p],i) =>
        `<div class="fl"><b>${i+1}</b><div><h5>${esc(h)}</h5><p>${p}</p></div></div>`).join("")}</div>`;
    case 3: return `
      <p class="prose" style="margin-bottom:22px">Run these one at a time, in order. Each block builds on the one before it.</p>
      ${it.steps.map(([h,c],i) =>
        `<div class="stepblock"><h5><b>${i+1}</b>${esc(h)}</h5>
        ${codeBlock(c, "Python \u00B7 Step "+(i+1), `sc${track}${cur}_${i}`)}</div>`).join("")}`;
    case 4: return `
      <p class="prose" style="margin-bottom:20px">The entire case as one program. Paste it into a single notebook cell and run.</p>
      ${codeBlock(it.whole, "Python \u00B7 Complete solution", "w"+track+cur)}`;
    case 5: return `
      <div class="verdict"><h4>${esc(it.decision.head)}</h4>${it.decision.body}</div>
      <div class="prose"><h4 style="font-size:17px;font-weight:700;margin-bottom:10px">Limits worth stating out loud</h4>
      ${it.decision.caveats}</div>`;
  }
}

/* ---------- dynamic wiring ---------- */
function wireDynamic(){
  document.querySelectorAll("[data-copy]").forEach(b =>
    b.addEventListener("click", () => {
      const pre = $(b.dataset.copy);
      navigator.clipboard.writeText(pre.innerText).then(() => {
        const old = b.textContent; b.textContent = "Copied";
        setTimeout(() => b.textContent = old, 1600);
      }).catch(() => { b.textContent = "Select and copy"; });
    }));

  const sol = $("showSol");
  if (sol) sol.addEventListener("click", () => { solved[track][cur] = true; render(); });

  document.querySelectorAll(".opt:not(.locked)").forEach(el =>
    el.addEventListener("click", () => {
      quiz[track][cur].picks[+el.dataset.q] = +el.dataset.o;
      $("panel").innerHTML = quizPanel(items[cur]); wireDynamic();
    }));

  const chk = $("check");
  if (chk) chk.addEventListener("click", () => {
    quiz[track][cur].checked = true;
    $("panel").innerHTML = quizPanel(items[cur]); wireDynamic();
  });
  const rt = $("retry");
  if (rt) rt.addEventListener("click", () => {
    quiz[track][cur] = { picks:{}, checked:false };
    $("panel").innerHTML = quizPanel(items[cur]); wireDynamic();
  });
}

/* ---------- navigation ---------- */
$("prevBtn").addEventListener("click", () => { if (cur > 0){ cur--; tab = 0; render(); }});
$("conceptBtn").addEventListener("click", () => { tab = 0; render(); });
$("nextBtn").addEventListener("click", () => {
  done[track].add(cur);
  if (cur < items.length-1){ cur++; tab = 0; }
  render();
});
document.addEventListener("keydown", e => {
  if (!$("lab").classList.contains("on")) return;
  if (e.target.tagName === "INPUT") return;
  const tabs = items[cur].type === "prac" ? PRAC_TABS : SCEN_TABS;
  if (e.key === "ArrowRight" && tab < tabs.length-1){ tab++; render(); }
  if (e.key === "ArrowLeft"  && tab > 0){ tab--; render(); }
});
</script>
