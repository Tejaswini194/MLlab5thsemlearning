<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lab — practicals, made clear.</title>
<meta name="description" content="A guided practical lab for Machine Learning based on given syllabus. Built for making practicals easy to understand.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --teal-900:#0B3136; --teal-800:#0F444A; --teal-700:#12595E;
  --teal-600:#0E7C77; --teal-500:#149289; --teal-300:#7FC7C0;
  --teal-100:#DFEFED; --teal-50:#F1F8F7;
  --ink:#14232A; --grey-700:#3D4E56; --grey-600:#5A6B73;
  --grey-400:#8B9AA1; --grey-200:#DCE3E6; --grey-100:#ECF0F2; --grey-50:#F6F8F9;
  --white:#FFFFFF; --amber:#A05E12; --amber-bg:#FBF1E2;
  --green:#1D7A54; --green-bg:#E7F4EE; --red:#B03A34; --red-bg:#FBECEB;
  --radius:14px; --radius-sm:9px;
  --shadow-sm:0 1px 2px rgba(20,35,42,.06), 0 1px 3px rgba(20,35,42,.05);
  --shadow-md:0 4px 14px rgba(20,35,42,.07), 0 1px 3px rgba(20,35,42,.05);
  --shadow-lg:0 18px 44px rgba(11,49,54,.12);
  --sans:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --mono:'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{
  font-family:var(--sans); color:var(--ink); background:var(--grey-50);
  font-size:15.5px; line-height:1.62; -webkit-font-smoothing:antialiased;
}
:focus-visible{outline:3px solid var(--teal-500); outline-offset:2px; border-radius:4px}
button{font-family:inherit; font-size:inherit; cursor:pointer; border:none; background:none; color:inherit}
code,pre{font-family:var(--mono)}
.hide{display:none !important}

/* ============ SHARED ============ */
.wrap{max-width:1080px; margin:0 auto; padding:0 24px}
.brandmark{display:flex; align-items:center; gap:12px}
.brandmark .glyph{
  width:42px;height:42px;border-radius:12px;flex:none;
  background:linear-gradient(145deg,var(--teal-600),var(--teal-800));
  display:grid;place-items:center;color:#fff;font-weight:800;font-size:17px;letter-spacing:-.5px;
}
.brandmark .glyph.sm{width:34px;height:34px;font-size:14px;border-radius:10px}
.brandmark h1{font-size:20px;font-weight:800;letter-spacing:-.4px;line-height:1.2}
.brandmark p{font-size:12.5px;color:var(--grey-600);letter-spacing:.02em}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  padding:13px 26px;border-radius:10px;font-weight:600;font-size:15px;
  transition:transform .14s ease, box-shadow .14s ease, background .14s ease;
}
.btn-primary{background:var(--teal-600); color:#fff; box-shadow:0 2px 10px rgba(14,124,119,.28)}
.btn-primary:hover{background:var(--teal-700); transform:translateY(-1px); box-shadow:0 6px 18px rgba(14,124,119,.32)}
.btn-ghost{background:var(--white); color:var(--teal-800); border:1.5px solid var(--grey-200)}
.btn-ghost:hover{border-color:var(--teal-300); background:var(--teal-50)}
.btn:disabled{opacity:.45; cursor:not-allowed; transform:none}

/* ============ SCREEN 1 — GATE ============ */
#gate{min-height:100vh; display:flex; flex-direction:column; background:var(--white)}
.gate-body{flex:1; display:grid; grid-template-columns:1.05fr .95fr; align-items:stretch}
.gate-left{padding:64px 60px; display:flex; flex-direction:column; justify-content:center; max-width:640px; margin-left:auto}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;align-self:flex-start;
  background:var(--teal-100);color:var(--teal-700);
  font-size:11.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;
  padding:7px 14px;border-radius:100px;margin-bottom:26px;
}
.gate-left h2{
  font-size:clamp(34px,4.2vw,50px); font-weight:800; letter-spacing:-1.4px;
  line-height:1.08; margin-bottom:20px;
}
.gate-left h2 em{font-style:normal; color:var(--ink)}
.gate-lede{font-size:17px; color:var(--grey-600); max-width:48ch; margin-bottom:14px}
.built-by{
  font-size:14.5px;color:var(--grey-700); margin-bottom:34px;
  padding-left:14px; border-left:3px solid var(--teal-300);
}
.built-by strong{color:var(--teal-700); font-weight:700}
.board{
  position:relative; overflow:hidden; background:#fff;
  border:1px solid var(--grey-200); border-radius:18px;
  padding:34px 34px 30px 38px; margin-bottom:32px;
  box-shadow:0 1px 2px rgba(20,35,42,.05), 0 18px 40px -26px rgba(20,35,42,.30);
}
.board::before{
  content:""; position:absolute; left:0; top:0; bottom:0; width:5px;
  background:linear-gradient(180deg, var(--teal-500), var(--teal-700));
}
.board h2{font-size:clamp(29px,3.25vw,39px); letter-spacing:-1px; margin-bottom:16px}
.board-desc{font-size:16.5px; line-height:1.6; color:var(--grey-600);
  max-width:52ch; margin:0}
.board-by{margin:16px 0 0; font-size:13.5px; color:var(--grey-400)}
.board-by strong{color:var(--teal-700); font-weight:600}
.gate-form{display:flex; gap:10px; flex-wrap:wrap; max-width:440px}
.gate-form input{
  flex:1; min-width:200px; padding:14px 16px; font-size:15.5px; font-family:inherit;
  border:1.5px solid var(--grey-200); border-radius:10px; background:var(--grey-50); color:var(--ink);
}
.gate-form input:focus{border-color:var(--teal-500); background:#fff; outline:none;
  box-shadow:0 0 0 4px rgba(20,146,137,.13)}
.gate-form #email{flex:1 1 100%}
.gate-form #pw{flex:1 1 55%; min-width:170px}
.gate-form #pwBtn{flex:1 1 auto}
.gate-msg.working{color:var(--grey-600)}
.gate-msg.good{color:var(--teal-600)}
#pwBtn[disabled]{opacity:.6; cursor:progress}
.gate-msg{margin-top:14px; font-size:14px; font-weight:600; color:var(--red); min-height:21px}
.gate-stats{display:flex; gap:30px; margin-top:44px; flex-wrap:wrap}
.gate-stats div span{display:block; font-size:26px; font-weight:800; color:var(--teal-700); letter-spacing:-.8px}
.gate-stats div small{font-size:12.5px; color:var(--grey-600); font-weight:500}
.gate-right{
  background:linear-gradient(160deg,var(--teal-800),var(--teal-900) 62%);
  padding:64px 56px; display:flex; align-items:center; justify-content:flex-start;
}
.stack-card{width:100%; max-width:400px}
.stack-card .sc-label{
  color:var(--teal-300); font-size:11.5px; font-weight:700;
  letter-spacing:.13em; text-transform:uppercase; margin-bottom:18px;
}
.sc-row{
  display:flex; align-items:center; gap:14px; padding:15px 18px; margin-bottom:9px;
  background:rgba(255,255,255,.055); border:1px solid rgba(255,255,255,.1);
  border-radius:11px; color:#fff;
}
.sc-row b{
  width:27px;height:27px;flex:none;border-radius:7px;display:grid;place-items:center;
  background:rgba(127,199,192,.2); color:var(--teal-300); font-size:12.5px; font-weight:700;
}
.sc-row span{font-size:14.5px; font-weight:500}
.sc-row small{margin-left:auto; font-size:11.5px; color:rgba(255,255,255,.5)}


/* ============ SCREEN 2 — TRACK PICKER ============ */
.picker-top{
  background:var(--white); border-bottom:1px solid var(--grey-200);
  padding:18px 0; position:sticky; top:0; z-index:20;
}
.picker-top .wrap{display:flex; align-items:center; justify-content:space-between; gap:16px}
.picker-main{flex:1; padding:64px 0 76px}
.picker-head h2{font-size:34px; font-weight:800; letter-spacing:-1px; margin-bottom:12px}
.picker-head p{color:var(--grey-600); font-size:16.5px}
.track > p{color:var(--grey-600); font-size:15px; margin-bottom:22px}
.track .btn{margin-top:auto; width:100%}
.track.soon h3, .track.soon li{color:var(--grey-600)}

/* ============ SCREEN 3 — LAB ============ */
#lab{display:none; min-height:100vh}
#lab.on{display:grid; grid-template-columns:300px 1fr}
.rail{
  background:var(--teal-900); color:#fff; padding:26px 0 0;
  position:sticky; top:0; height:100vh; overflow-y:auto;
  display:flex; flex-direction:column;
}
.rail::-webkit-scrollbar{width:7px}
.rail::-webkit-scrollbar-thumb{background:rgba(255,255,255,.16); border-radius:4px}
.rail-head{padding:0 24px 20px; border-bottom:1px solid rgba(255,255,255,.1)}
.rail-head .brandmark h1{color:#fff; font-size:17px}
.rail-head .brandmark p{color:var(--teal-300)}
.rail-back{margin-top:16px; font-size:13px; font-weight:600; color:rgba(255,255,255,.6)}
.rail-back:hover{color:#fff}
.prog{padding:20px 24px 18px; border-bottom:1px solid rgba(255,255,255,.1)}
.prog-top{display:flex; justify-content:space-between; font-size:13px; margin-bottom:10px}
.prog-top span:first-child{color:rgba(255,255,255,.68)}
.prog-top span:last-child{font-weight:700; color:var(--teal-300)}
.prog-bar{height:6px; background:rgba(255,255,255,.13); border-radius:100px; overflow:hidden}
.prog-fill{height:100%; width:0%; background:var(--teal-300); border-radius:100px; transition:width .35s ease}
.rail-section{border-bottom:1px solid rgba(255,255,255,.07)}
.rail-section:last-child{border-bottom:none; padding-bottom:26px}
.rail-group{padding:18px 24px 8px; font-size:10.5px; font-weight:700;
  letter-spacing:.14em; text-transform:uppercase; color:rgba(255,255,255,.42);
  display:flex; align-items:center; justify-content:space-between; gap:10px}
.rail-group b{font-size:10.5px; font-weight:700; letter-spacing:.04em;
  color:var(--teal-300); background:rgba(127,199,192,.14);
  padding:3px 8px; border-radius:100px}
.rail-list{padding:0 12px 14px; display:flex; flex-direction:column; gap:3px}
.rail-item{
  display:flex; gap:13px; align-items:flex-start; text-align:left; width:100%;
  padding:12px 14px; border-radius:10px; transition:background .14s ease;
}
.rail-item:hover{background:rgba(255,255,255,.07)}
.rail-item.sel{background:#fff; box-shadow:var(--shadow-md)}
.rail-num{
  width:25px;height:25px;flex:none;border-radius:7px;display:grid;place-items:center;
  font-size:12px;font-weight:700; background:rgba(255,255,255,.12); color:rgba(255,255,255,.82);
}
.rail-item.sel .rail-num{background:var(--teal-600); color:#fff}
.rail-item.done .rail-num{background:var(--teal-500); color:#fff}
.rail-item.sel.done .rail-num{background:var(--teal-600)}
.rail-txt strong{display:block; font-size:14px; font-weight:600; line-height:1.35; color:#fff}
.rail-txt small{font-size:11.5px; color:rgba(255,255,255,.5); font-weight:500}
.rail-item.sel .rail-txt strong{color:var(--ink); font-weight:700}
.rail-item.sel .rail-txt small{color:var(--teal-600); font-weight:600}

.stage{display:flex; flex-direction:column; min-width:0}
.stage-inner{flex:1; padding:30px 40px 50px; max-width:1000px; width:100%}
.stage-top{display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:20px; flex-wrap:wrap}
.chip{
  background:var(--teal-100); color:var(--teal-700); font-size:11.5px; font-weight:700;
  letter-spacing:.1em; text-transform:uppercase; padding:7px 15px; border-radius:100px;
}
.chip.alt{background:var(--amber-bg); color:var(--amber)}
.chip.soft{background:var(--grey-100); color:var(--grey-700)}
.counter{font-size:14.5px; font-weight:600; color:var(--grey-600)}
.card{background:var(--white); border:1px solid var(--grey-200); border-radius:var(--radius); box-shadow:var(--shadow-sm); overflow:hidden}
.hero{padding:38px 40px; background:linear-gradient(135deg,var(--teal-50),var(--white) 72%); border-bottom:1px solid var(--grey-200)}
.hero h2{font-size:33px; font-weight:800; letter-spacing:-1.1px; line-height:1.14; margin-bottom:12px}
.hero p{font-size:16.5px; color:var(--grey-700); max-width:70ch}
.hero .unit{
  display:inline-block; font-size:11.5px; font-weight:700; letter-spacing:.08em;
  color:var(--teal-700); background:var(--white); border:1px solid var(--teal-100);
  padding:5px 12px; border-radius:100px; margin-bottom:16px;
}
.tabs{display:flex; gap:6px; padding:14px 24px; background:var(--grey-50);
  border-bottom:1px solid var(--grey-200); overflow-x:auto; scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{padding:10px 18px; border-radius:9px; font-size:14.5px; font-weight:600;
  color:var(--grey-600); white-space:nowrap; transition:all .14s ease}
.tab:hover{background:var(--grey-100); color:var(--ink)}
.tab.sel{background:var(--teal-800); color:#fff}
.panel{padding:34px 40px 40px; min-height:340px}

.duo{display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:26px}
.box{background:var(--grey-50); border:1px solid var(--grey-200); border-radius:var(--radius-sm); padding:22px 24px}
.box h4{font-size:16px; font-weight:700; margin-bottom:9px}
.box p{font-size:15px; color:var(--grey-700)}
.prose p{margin-bottom:14px; color:var(--grey-700)}
.prose p:last-child{margin-bottom:0}
.prose strong{color:var(--ink); font-weight:650}
.pipeline{display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-top:24px}
.pipeline b{background:var(--teal-100); color:var(--teal-700); font-size:13.5px; font-weight:700;
  padding:10px 16px; border-radius:9px}
.pipeline i{color:var(--grey-400); font-style:normal; font-weight:700}
.callout{background:var(--teal-50); border-left:3px solid var(--teal-500);
  padding:18px 22px; border-radius:0 var(--radius-sm) var(--radius-sm) 0; margin-top:24px}
.callout h5{font-size:14px; font-weight:700; color:var(--teal-800); margin-bottom:6px}
.callout p{font-size:14.5px; color:var(--grey-700)}

.codewrap{border-radius:var(--radius-sm); overflow:hidden; border:1px solid var(--teal-900)}
.codebar{background:var(--teal-900); padding:12px 18px; display:flex; align-items:center;
  justify-content:space-between; gap:14px}
.codebar span{font-size:12.5px; color:rgba(255,255,255,.6); font-family:var(--mono)}
.copybtn{background:rgba(255,255,255,.12); color:#fff; font-size:12.5px; font-weight:600;
  padding:7px 14px; border-radius:7px; transition:background .14s}
.copybtn:hover{background:rgba(255,255,255,.22)}
pre.code{background:#0A2B30; color:#DCE9E8; padding:24px; overflow-x:auto;
  font-size:13.5px; line-height:1.75; margin:0; white-space:pre}
pre.code .hl{color:#FFD79A; font-weight:600; display:inline-block; width:100%}
pre.out{background:#0A2B30; color:#B9E4DC; padding:24px; overflow-x:auto;
  font-size:13.5px; line-height:1.85; margin:0; border-radius:var(--radius-sm); white-space:pre}

.exp-row{display:grid; grid-template-columns:230px 1fr; gap:26px; align-items:start;
  padding:17px 0; border-bottom:1px solid var(--grey-100)}
.exp-row:last-child{border-bottom:none}
.exp-row code{background:var(--amber-bg); color:var(--amber); font-size:13px; font-weight:500;
  padding:6px 11px; border-radius:7px; display:inline-block; word-break:break-word}
.exp-row p{font-size:15px; color:var(--grey-700); padding-top:4px}

.mini{background:var(--teal-50); border-left:3px solid var(--teal-600);
  padding:20px 24px; border-radius:0 var(--radius-sm) var(--radius-sm) 0; margin-bottom:20px}
.mini h4{font-size:16.5px; font-weight:700; margin-bottom:7px}
.mini p{font-size:15px; color:var(--grey-700)}
.hint{border:1.5px dashed var(--grey-200); border-radius:var(--radius-sm);
  padding:16px 22px; font-size:14.5px; color:var(--grey-700); margin-bottom:24px}
.hint b{color:var(--ink)}
.solnote{font-size:13.5px; color:var(--grey-600); margin-top:14px}
.solnote b{color:var(--amber)}

/* MCQ */
.quiz-head{display:flex; align-items:center; justify-content:space-between; gap:16px;
  margin-bottom:24px; flex-wrap:wrap}
.quiz-head h3{font-size:19px; font-weight:700}
.quiz-head p{font-size:14.5px; color:var(--grey-600)}
.score{background:var(--teal-800); color:#fff; padding:10px 20px; border-radius:100px;
  font-size:14.5px; font-weight:700}
.q{border:1px solid var(--grey-200); border-radius:var(--radius-sm); padding:22px 24px; margin-bottom:16px}
.q > h5{font-size:15.5px; font-weight:650; margin-bottom:15px; line-height:1.5}
.q > h5 b{color:var(--teal-600); margin-right:8px; font-weight:700}
.opts{display:flex; flex-direction:column; gap:8px}
.opt{display:flex; gap:12px; align-items:flex-start; text-align:left; width:100%;
  padding:13px 16px; border:1.5px solid var(--grey-200); border-radius:9px;
  font-size:14.5px; color:var(--grey-700); transition:all .13s ease}
.opt:hover:not(.locked){border-color:var(--teal-500); background:var(--teal-50)}
.opt.locked{cursor:default}
.opt em{width:23px;height:23px;flex:none;border-radius:6px;display:grid;place-items:center;
  background:var(--grey-100); color:var(--grey-600); font-style:normal; font-size:12px; font-weight:700}
.opt.pick{border-color:var(--teal-600); background:var(--teal-50)}
.opt.pick em{background:var(--teal-600); color:#fff}
.opt.right{border-color:var(--green); background:var(--green-bg); color:var(--ink)}
.opt.right em{background:var(--green); color:#fff}
.opt.wrong{border-color:var(--red); background:var(--red-bg); color:var(--ink)}
.opt.wrong em{background:var(--red); color:#fff}
.why{margin-top:14px; padding:14px 18px; background:var(--grey-50);
  border-left:3px solid var(--teal-500); border-radius:0 8px 8px 0; font-size:14.5px; color:var(--grey-700)}
.why b{color:var(--ink)}
.quiz-foot{display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-top:24px;
  padding-top:24px; border-top:1px solid var(--grey-200)}
.result{font-size:15px; font-weight:600}
.result.pass{color:var(--green)} .result.mid{color:var(--amber)} .result.low{color:var(--red)}

.nav{display:flex; align-items:center; justify-content:space-between; gap:14px;
  padding:22px 40px; border-top:1px solid var(--grey-200); background:var(--grey-50); flex-wrap:wrap}
.nav-right{display:flex; gap:12px; flex-wrap:wrap}

/* Scenario */
.scen{background:linear-gradient(140deg,var(--teal-800),var(--teal-900));
  color:#fff; padding:30px 34px; border-radius:var(--radius-sm); margin-bottom:22px}
.scen h4{font-size:17px; font-weight:700; margin-bottom:11px; color:var(--teal-300)}
.scen p{font-size:16px; color:rgba(255,255,255,.9)}
.think-list{display:flex; flex-direction:column; gap:14px}
.think{display:grid; grid-template-columns:34px 1fr; gap:16px; align-items:start;
  padding:18px 20px; background:var(--grey-50); border:1px solid var(--grey-200); border-radius:var(--radius-sm)}
.think b{width:34px;height:34px;border-radius:9px;display:grid;place-items:center;
  background:var(--teal-100); color:var(--teal-700); font-size:14px; font-weight:700}
.think h5{font-size:15.5px; font-weight:700; margin-bottom:5px}
.think p{font-size:14.5px; color:var(--grey-700)}
.flowline{display:flex; flex-direction:column; gap:0}
.fl{display:grid; grid-template-columns:30px 1fr; gap:18px; padding-bottom:22px; position:relative}
.fl:not(:last-child)::before{content:''; position:absolute; left:14px; top:32px; bottom:0;
  width:2px; background:var(--grey-200)}
.fl b{width:30px;height:30px;border-radius:100px;display:grid;place-items:center; z-index:1;
  background:var(--teal-600); color:#fff; font-size:12.5px; font-weight:700}
.fl h5{font-size:15.5px; font-weight:700; margin-bottom:4px; padding-top:3px}
.fl p{font-size:14.5px; color:var(--grey-700)}
.stepblock{margin-bottom:26px}
.stepblock h5{font-size:15.5px; font-weight:700; margin-bottom:11px; display:flex; gap:10px; align-items:center}
.stepblock h5 b{background:var(--teal-100); color:var(--teal-700); width:25px; height:25px;
  border-radius:7px; display:grid; place-items:center; font-size:12px; flex:none}
.verdict{background:var(--teal-50); border:1.5px solid var(--teal-300); border-radius:var(--radius-sm);
  padding:26px 30px; margin-bottom:20px}
.verdict h4{font-size:18px; font-weight:800; color:var(--teal-800); margin-bottom:11px}
.verdict p{font-size:15.5px; color:var(--grey-700); margin-bottom:12px}
.verdict p:last-child{margin-bottom:0}

/* ============ FOOTER ============ */
footer{background:var(--teal-900); color:rgba(255,255,255,.72); padding:40px 0 34px; margin-top:auto}
