y = df["price"]            # 1-D
X_tr, X_te, y_tr, y_te = train_test_split(X, y, test_size=0.2, random_state=5)

model = LinearRegression().fit(X_tr, y_tr)
pred = model.predict(X_te)

print("=== THE FITTED LINE ===")
print(f"Slope     : {model.coef_[0]:,.2f} rupees per sq ft")
print(f"Intercept : {model.intercept_:,.2f}")
print(f"Equation  : price = {model.coef_[0]:,.0f} x size + {model.intercept_:,.0f}")
print("\\nIn plain words: each extra square foot adds about "
      f"{model.coef_[0]:,.0f} rupees to the predicted price.")

print("\\n=== ERROR MEASURES ===")
mae  = mean_absolute_error(y_te, pred)
mse  = mean_squared_error(y_te, pred)
rmse = np.sqrt(mse)
print(f"MAE  : {mae:>12,.0f}   average miss, in rupees")
print(f"MSE  : {mse:>12,.0f}   squared units, not interpretable")
print(f"RMSE : {rmse:>12,.0f}   back in rupees, punishes big misses")
print(f"R2   : {r2_score(y_te, pred):>12.4f}   share of variation explained")
print(f"\\nRMSE/MAE ratio: {rmse/mae:.3f}")
print("Close to 1.0 means errors are evenly spread; much higher means")
print("a few predictions are badly wrong.")

print("\\n=== PREDICTIONS (inside the training range) ===")
print(f"Model saw sizes from {df['size_sqft'].min()} to {df['size_sqft'].max()} sq ft")
query = pd.DataFrame({"size_sqft": [800, 1500, 2400, 3200]})
for s, p in zip(query["size_sqft"], model.predict(query)):
    print(f"  {s:>5} sq ft -> {p:>12,.0f}")

# Residuals: the errors should look like random noise
resid = y_te - pred
print("\\n=== RESIDUAL CHECK ===")
print(f"Mean residual: {resid.mean():,.2f}  (should be near zero)")
print(f"Std residual : {resid.std():,.0f}")

fig, ax = plt.subplots(1, 2, figsize=(14, 5))
ax[0].scatter(X_te, y_te, alpha=.6, color="teal", label="Actual")
ax[0].plot(X_te, pred, color="darkred", linewidth=2, label="Fitted line")
ax[0].set_xlabel("Size (sq ft)"); ax[0].set_ylabel("Price")
ax[0].set_title("Simple Linear Regression"); ax[0].legend()
ax[1].scatter(pred, resid, alpha=.6, color="darkslategray")
ax[1].axhline(0, color="darkred", linestyle="--", linewidth=2)
ax[1].set_xlabel("Predicted price"); ax[1].set_ylabel("Residual")
