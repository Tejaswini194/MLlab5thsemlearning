print("=== THE XOR PROBLEM ===")
X_xor = np.array([[0,0],[0,1],[1,0],[1,1]])
y_xor = np.array([0, 1, 1, 0])          # no straight line separates these

p = Perceptron(max_iter=2000, random_state=0).fit(X_xor, y_xor)
print("Single perceptron on XOR:", p.predict(X_xor), " actual:", y_xor)
print(f"Accuracy: {accuracy_score(y_xor, p.predict(X_xor)):.4f}  <- no better than guessing")

